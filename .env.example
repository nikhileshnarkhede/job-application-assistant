# =============================================================================
# Environment Variables Template
# =============================================================================
# IMPORTANT: Docker requires NO SPACES around the = sign!
# ✅ Correct: OPENAI_API_KEY=sk-xxx
# ❌ Wrong:   OPENAI_API_KEY = sk-xxx
# =============================================================================

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub Integration (REQUIRED for project ranking)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_your-github-token-here

# HuggingFace (Optional)
HUGGINGFACEHUB_API_TOKEN=hf_your-token-here

# LangSmith (Optional - for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=job-application-assistant

# Model Configuration
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Application Settings
ATS_SCORE_THRESHOLD=95
RESUME_RUBRIC_THRESHOLD=85
COVER_LETTER_RUBRIC_THRESHOLD=85

# Paths
RESOURCES_PATH=./resources
APPLICATIONS_PATH=./applications
VECTORSTORES_PATH=./vectorstores
CHECKPOINTS_PATH=./data/checkpoints
DATA_PATH=./data

# GitHub Repos Path (for local repo scanning - optional)
GITHUB_REPOS_PATH=
