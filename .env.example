# ============================================================================
# JOB APPLICATION ASSISTANT - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# LLM API KEYS (at least one required)
# ============================================================================

# OpenAI API Key (required for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (optional - for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# HuggingFace API Token (optional - for embeddings)
HUGGINGFACEHUB_API_TOKEN=hf_your-huggingface-token-here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Default LLM model
DEFAULT_MODEL=gpt-4o-mini
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, claude-sonnet-4-20250514

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# LANGSMITH TRACING (Optional)
# ============================================================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=job-application-assistant

# ============================================================================
# GITHUB CONFIGURATION (Optional)
# ============================================================================

# GitHub Personal Access Token (for fetching repo data)
GITHUB_TOKEN=github_pat_your-github-token-here
GITHUB_USERNAME=your-github-username

# Path to local cloned GitHub repos (optional - for offline scanning)
# Example: D:\Projects or /home/user/projects
GITHUB_REPOS_PATH=

# ============================================================================
# APPLICATION THRESHOLDS
# ============================================================================

# ATS score threshold (resume must score >= this to pass)
ATS_SCORE_THRESHOLD=95

# Resume rubric threshold (must score >= this to pass compliance)
RESUME_RUBRIC_THRESHOLD=85

# Cover letter rubric threshold
COVER_LETTER_RUBRIC_THRESHOLD=85

# ============================================================================
# PATHS (usually don't need to change)
# ============================================================================

RESOURCES_PATH=./resources
APPLICATIONS_PATH=./applications
VECTORSTORES_PATH=./vectorstores
CHECKPOINTS_PATH=./data/checkpoints
DATA_PATH=./data
